{
  "name": "@freelancing/monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "workspaces/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@freelancing/design-system",
    "build": "npm run build --workspace=@freelancing/design-system",
    "dev:design-system": "npm run dev --workspace=@freelancing/design-system",
    "build:design-system": "npm run build --workspace=@freelancing/design-system",
    "dev:twitter": "npm run dev --workspace=@freelancing/twitter",
    "build:twitter": "npm run build --workspace=@freelancing/twitter",
    "dev:sudoku": "npm run dev --workspace=@freelancing/sudoku",
    "build:sudoku": "npm run build --workspace=@freelancing/sudoku",
    "build:ui": "npm run build --workspace=@freelancing/ui"
  }
}
